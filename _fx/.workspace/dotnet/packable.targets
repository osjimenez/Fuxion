<Project>

	<!-- The README and the icon of the packages. The icon is the one next to this file (it travels with it to each repo's
	     _fx/.workspace/dotnet/); a repo that sets its own PackageIcon keeps it. -->
	<PropertyGroup>
		<PackageReadmeFile Condition="'$(PackageReadmeFile)' == '' And Exists('$(MSBuildProjectDirectory)/PACKAGE_README.md')">PACKAGE_README.md</PackageReadmeFile>
		<_FuxionDefaultIcon Condition="'$(PackageIcon)' == ''">true</_FuxionDefaultIcon>
		<PackageIcon Condition="'$(PackageIcon)' == ''">icon.png</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<None Include="$(MSBuildProjectDirectory)/PACKAGE_README.md" Pack="true" PackagePath="\" Condition="'$(PackageReadmeFile)' == 'PACKAGE_README.md'" />
		<None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" Visible="false" Condition="'$(_FuxionDefaultIcon)' == 'true'" />
	</ItemGroup>

</Project>
