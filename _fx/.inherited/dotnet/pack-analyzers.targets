<Project>

	<!-- The analyzers of Fuxion inside every package of oss (from oss's Nuget.Pack.Analyzers, plan R): the analyzer and
	     its code fixes in analyzers/dotnet/cs, and the attributes (Abstractions), which the users need at run time, in
	     lib/ of each framework. Their projects come from the map of the repository (FxRepositoryProject); the analyzer
	     projects themselves say UseFuxionAnalyzers=false. -->
	<PropertyGroup Condition="'$(UseFuxionAnalyzers)' != 'false'">
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);FuxionAbstractionsInPackage</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>

	<!-- Built before packing, in the framework they ship (netstandard2.0), and packed as they are. When the pack does not
	     build (NoBuild: the CI builds the solution first) they are built already, and Build would fail (NETSDK1085) -->
	<Target Name="FuxionAnalyzersInPackage" BeforeTargets="_GetPackageFiles" Condition="'$(UseFuxionAnalyzers)' != 'false'">
		<ItemGroup>
			<_FuxionPackedAnalyzer Include="@(FxRepositoryProject)" Condition="'%(Identity)' == 'Fuxion.Analyzers' Or '%(Identity)' == 'Fuxion.Analyzers.CodeFixes'" />
			<_FuxionPackedAnalyzer Include="@(FxRepositoryProject)" Condition="'%(Identity)' == 'Fuxion.Analyzers.Abstractions'" Library="true" />
		</ItemGroup>
		<MSBuild Projects="@(_FuxionPackedAnalyzer->'%(Path)')" Targets="Build" Properties="Configuration=$(Configuration);TargetFramework=netstandard2.0"
		         Condition="'$(NoBuild)' != 'true'" />
		<ItemGroup>
			<None Include="$([System.IO.Path]::GetDirectoryName('%(_FuxionPackedAnalyzer.Path)'))\bin\$(Configuration)\netstandard2.0\%(_FuxionPackedAnalyzer.Identity).dll"
			      Condition="'%(_FuxionPackedAnalyzer.Library)' != 'true'" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
		</ItemGroup>
	</Target>

	<Target Name="FuxionAbstractionsInPackage">
		<ItemGroup>
			<_FuxionAbstractions Include="@(FxRepositoryProject)" Condition="'%(Identity)' == 'Fuxion.Analyzers.Abstractions'" />
			<TfmSpecificPackageFile Include="$([System.IO.Path]::GetDirectoryName('%(_FuxionAbstractions.Path)'))\bin\$(Configuration)\netstandard2.0\Fuxion.Analyzers.Abstractions.dll"
			                        PackagePath="lib/$(TargetFramework)" />
		</ItemGroup>
	</Target>

</Project>
