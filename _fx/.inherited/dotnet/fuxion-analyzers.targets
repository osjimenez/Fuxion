<Project>

	<!-- The analyzers of Fuxion in the repos that use Fuxion, and in oss itself (from oss's old Analyzers.Reference.props).
	     In oss and in the space they are its projects (the map of the repository or of the space); outside the
	     space they come inside the Fuxion package (SpaceOnly). A project that must not have them (an analyzer
	     project, an Aspire app host) says <UseFuxionAnalyzers>false</UseFuxionAnalyzers>. -->
	<ItemGroup>
		<FxReference Include="Fuxion.Analyzers.Abstractions" SpaceOnly="true" ReferenceOutputAssembly="true" PrivateAssets="none" />
		<FxReference Include="Fuxion.Analyzers" SpaceOnly="true" ReferenceOutputAssembly="false" OutputItemType="Analyzer" PrivateAssets="all" />
		<FxReference Include="Fuxion.Analyzers.CodeFixes" SpaceOnly="true" ReferenceOutputAssembly="false" OutputItemType="Analyzer" PrivateAssets="all" />
	</ItemGroup>

	<!-- Visual Studio's live analysis does not build referenced projects: it needs the analyzers' dll to show their
	     diagnostics in the editor (the "force-load" of oss's old Analyzers.Reference.props). The path comes from the map of
	     the repository (FxRepositoryProject, in oss) or of the space (FxSpaceProject); before CoreCompile, so it
	     reaches both the compiler and CollectAnalyzersDesignTime (which runs CompileDesignTime). Only if the dll is there
	     (built). -->
	<Target Name="FuxionAnalyzersForTheEditor" BeforeTargets="CoreCompile" Condition="'@(FxRepositoryProject)@(FxSpaceProject)' != ''">
		<ItemGroup>
			<_FuxionAnalyzerProject Include="@(FxRepositoryProject)" Condition="'%(Identity)' == 'Fuxion.Analyzers' Or '%(Identity)' == 'Fuxion.Analyzers.CodeFixes'" />
			<_FuxionAnalyzerProject Include="@(FxSpaceProject)" Exclude="@(_FuxionAnalyzerProject)" Condition="'%(Identity)' == 'Fuxion.Analyzers' Or '%(Identity)' == 'Fuxion.Analyzers.CodeFixes'" />
			<_FuxionAnalyzerDll Include="$([System.IO.Path]::GetDirectoryName('%(_FuxionAnalyzerProject.Path)'))\bin\$(Configuration)\netstandard2.0\%(_FuxionAnalyzerProject.Identity).dll" />
			<Analyzer Include="@(_FuxionAnalyzerDll)" Condition="Exists('%(FullPath)')" Exclude="@(Analyzer)" />
		</ItemGroup>
	</Target>

</Project>
