<Project>
	<PropertyGroup>
		<!--
			This repo can be built standalone.
			When it's checked out as a submodule under the Fuxion-plus super-repo,
			the tool may be available in the parent solution and will be used.
			If the tool isn't available, versioning is skipped.
		-->
		<FuxionTools_ParentSolutionDir>$(MSBuildThisFileDirectory)..\..\solution\</FuxionTools_ParentSolutionDir>
		<FuxionTools_Project>$(FuxionTools_ParentSolutionDir)tools\Tools\Fuxion.Tools.csproj</FuxionTools_Project>
		<FuxionTools_EntryDll>$(FuxionTools_ParentSolutionDir)tools\Tools\bin\$(Configuration)\net10.0\Fuxion.Tools.dll</FuxionTools_EntryDll>
		<FuxionTools_ConfigFile>$(FuxionTools_ParentSolutionDir)fuxion-tools.json</FuxionTools_ConfigFile>

		<FuxionTools_CacheDir>$(FuxionTools_ParentSolutionDir)~$fuxion.tools\build\</FuxionTools_CacheDir>
		<FuxionTools_GeneratedProps>$(FuxionTools_CacheDir)version.g.props</FuxionTools_GeneratedProps>
	</PropertyGroup>

	<Target Name="FuxionTools_Build_IfAvailable"
			BeforeTargets="PrepareForBuild"
			Condition="'$(DesignTimeBuild)' != 'true' And !Exists('$(FuxionTools_EntryDll)') And Exists('$(FuxionTools_Project)')">
		<Exec Command="dotnet build &quot;$(FuxionTools_Project)&quot; -c $(Configuration)" />
	</Target>

	<Target Name="FuxionTools_GenerateVersionProps_IfAvailable"
			BeforeTargets="PrepareForBuild"
			AfterTargets="FuxionTools_Build_IfAvailable"
			Condition="'$(DesignTimeBuild)' != 'true' And Exists('$(FuxionTools_EntryDll)') And !Exists('$(FuxionTools_GeneratedProps)')">
		<MakeDir Directories="$(FuxionTools_CacheDir)" />
		<Exec Command="dotnet exec &quot;$(FuxionTools_EntryDll)&quot; version --output &quot;$(FuxionTools_GeneratedProps)&quot; --config &quot;$(FuxionTools_ConfigFile)&quot;" />
	</Target>

	<Import Project="$(FuxionTools_GeneratedProps)" Condition="Exists('$(FuxionTools_GeneratedProps)')" />
</Project>
