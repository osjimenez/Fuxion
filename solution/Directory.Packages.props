<Project>
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
	</PropertyGroup>

	<ItemGroup>
		<PackageVersion Include="coverlet.collector" Version="10.0.1" />
		<PackageVersion Include="EntityFramework" Version="6.5.2" />
		<PackageVersion Include="Microsoft.AspNet.WebApi.Core" Version="5.3.0" />
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" />
		<PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.6.0" />
		<PackageVersion Include="Microsoft.CSharp" Version="4.7.0" />
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
		<PackageVersion Include="PolySharp" Version="1.16.0" />
		<PackageVersion Include="xunit.analyzers" Version="1.27.0" />
		<PackageVersion Include="xunit.v3" Version="3.2.2" />
		<PackageVersion Include="xunit.v3.assert" Version="3.2.2" />
		<PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
	</ItemGroup>

	<!-- Microsoft.SourceLink.GitHub -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
		<PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100-preview.7.26381.103" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' != 'net11.0'">
		<PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.400" />
	</ItemGroup>

	<!-- MongoDB.EntityFrameworkCore -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0' Or '$(TargetFramework)' == 'net11.0'">
		<PackageVersion Include="MongoDB.EntityFrameworkCore" Version="10.0.2" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' != 'net10.0' And '$(TargetFramework)' != 'net11.0'">
		<PackageVersion Include="MongoDB.EntityFrameworkCore" Version="9.1.2" />
	</ItemGroup>

	<!-- Framework Packages -->
	<PropertyGroup>
		<NetStableVersion>10.0.11</NetStableVersion>
	</PropertyGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'
			   Or '$(TargetFramework)' == 'net10.0-windows10.0.19041'
			   Or '$(TargetFramework)' == 'net472'
			   Or '$(TargetFramework)' == 'netstandard2.0'">
		<PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(NetStableVersion)" />
		<PackageVersion Include="Microsoft.Extensions.Http" Version="$(NetStableVersion)" />
		<PackageVersion Include="Microsoft.Extensions.Logging.Configuration" Version="$(NetStableVersion)" />
		<PackageVersion Include="System.Drawing.Common" Version="$(NetStableVersion)" />
		<PackageVersion Include="System.Management" Version="$(NetStableVersion)" />
		<PackageVersion Include="System.Text.Json" Version="$(NetStableVersion)" />
	</ItemGroup>

	<!-- Packages in preview version -->
	<PropertyGroup>
		<NetPreviewVersion>11.0.0-preview.7.26381.103</NetPreviewVersion>
	</PropertyGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net11.0'
			   Or '$(TargetFramework)' == 'net11.0-windows10.0.19041'">
		<PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(NetPreviewVersion)" />
		<PackageVersion Include="Microsoft.Extensions.Http" Version="$(NetPreviewVersion)" />
		<PackageVersion Include="Microsoft.Extensions.Logging.Configuration" Version="$(NetPreviewVersion)" />
		<PackageVersion Include="System.Drawing.Common" Version="$(NetPreviewVersion)" />
		<PackageVersion Include="System.Management" Version="$(NetPreviewVersion)" />
		<PackageVersion Include="System.Text.Json" Version="$(NetPreviewVersion)" />
	</ItemGroup>

	<!-- Entity Framework Core Packages -->
	<PropertyGroup>
		<EntityFrameworkCore10Version>10.0.11</EntityFrameworkCore10Version>
	</PropertyGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'
			   Or '$(TargetFramework)' == 'net10.0-windows10.0.19041'">
		<PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(EntityFrameworkCore10Version)" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="$(EntityFrameworkCore10Version)" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(EntityFrameworkCore10Version)" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(EntityFrameworkCore10Version)" />
	</ItemGroup>
	<PropertyGroup>
		<EntityFrameworkCore11Version>11.0.0-preview.7.26381.103</EntityFrameworkCore11Version>
	</PropertyGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net11.0'
			   Or '$(TargetFramework)' == 'net11.0-windows10.0.19041'">
		<PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(EntityFrameworkCore11Version)" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="$(EntityFrameworkCore11Version)" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(EntityFrameworkCore11Version)" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(EntityFrameworkCore11Version)" />
	</ItemGroup>
</Project>