<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>$(OldFrameworks)</TargetFrameworks>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="$(XunitProjectPath)" />
		<ProjectReference Include="$(AspNetProjectPath)" />
		<ProjectReference Include="$(HttpProjectPath)" />
		<ProjectReference Include="$(Test_Responses_SharedProjectPath)" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
