<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>$(LatestCoreFramework)</TargetFramework>
		<!-- Test.Responses.Shared pulls in xunit.v3's buildTransitive targets, which would otherwise
		     generate a second entry point clashing with this host's own Program.Main. -->
		<XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="$(FuxionProjectPath)" />
		<ProjectReference Include="$(AspNetCoreProjectPath)" />
		<ProjectReference Include="$(Test_Responses_SharedProjectPath)" />
	</ItemGroup>

</Project>