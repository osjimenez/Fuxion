<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>$(LatestCoreFramework)</TargetFramework>
		<!-- The service hosted by Test.AspNetCore, not a test project: keeps the test framework out (Project.Test.props). -->
		<IsTestProject>false</IsTestProject>
		<!-- Never packed: the web SDK warns when a non-packable web project is packed (dotnet pack of the solution) -->
		<WarnOnPackingNonPackableProject>false</WarnOnPackingNonPackableProject>
	</PropertyGroup>

	<ItemGroup>
		<FxReference Include="Fuxion" />
		<FxReference Include="Fuxion.AspNetCore" />
		<FxReference Include="Test.Responses.Shared.Fixtures" />
	</ItemGroup>

</Project>