<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>$(LatestCoreFramework)</TargetFramework>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="$(XunitProjectPath)" />
		<ProjectReference Include="$(AspNetCoreProjectPath)" />
		<ProjectReference Include="$(HttpProjectPath)" />
		<ProjectReference Include="$(Test_AspNetCore_ServiceProjectPath)" />
		<ProjectReference Include="$(Test_Responses_SharedProjectPath)" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
