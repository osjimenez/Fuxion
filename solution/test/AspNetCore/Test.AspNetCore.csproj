<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<IsTestProject>true</IsTestProject>
		<TargetFramework>$(LatestCoreFramework)</TargetFramework>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
	</ItemGroup>

	<ItemGroup>
		<FxReference Include="Fuxion.Xunit" />
		<FxReference Include="Fuxion.AspNetCore" />
		<FxReference Include="Fuxion.Http" />
		<FxReference Include="Test.AspNetCore.Service" />
		<FxReference Include="Test.Responses.Shared" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
