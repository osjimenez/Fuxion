<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>$(CoreAndOldFrameworks)</TargetFrameworks>
		<!-- test/Directory.Build.props sets OutputType=Exe for everything under test/: xunit.v3's own build
		     validation requires it even for a library like this one that hosts no [Fact] itself (Fuxion.Xunit,
		     which this project references, does exactly the same for the same reason). XunitAutoGeneratedEntryPoint
		     is turned off so that Exe stays a formality: no Main is generated, and this project is not a phantom
		     test runner. -->
		<XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
		<IsPackable>false</IsPackable>
		<IsTestProject>false</IsTestProject>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="$(XunitProjectPath)" />
		<ProjectReference Include="$(FuxionProjectPath)" />
		<ProjectReference Include="$(HttpProjectPath)" />
		<ProjectReference Include="$(Test_Responses_Shared_FixturesProjectPath)" />
	</ItemGroup>

</Project>
