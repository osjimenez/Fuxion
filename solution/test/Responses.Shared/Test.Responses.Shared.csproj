<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>$(CoreAndOldFrameworks)</TargetFrameworks>
		<!-- A library, not a test project: it only hosts the abstract test families that each host project
		     specializes. [Fact] and ITestOutputHelper come through Fuxion.Xunit (xunit.v3.extensibility.core). -->
		<OutputType>Library</OutputType>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<!-- The shared families hold [Fact]s too: the same xUnit rules as the test projects. -->
		<PackageReference Include="xunit.analyzers" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<FxReference Include="Fuxion.Xunit" />
		<FxReference Include="Fuxion" />
		<FxReference Include="Fuxion.Http" />
		<FxReference Include="Test.Responses.Shared.Fixtures" />
	</ItemGroup>

</Project>
