<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>$(CoreAndOldFrameworks)</TargetFrameworks>
		<!-- A library, not a test project: it only hosts the abstract test families that each host project
		     specializes. [Fact] and ITestOutputHelper come through Fuxion.Xunit (xunit.v3.extensibility.core). -->
		<OutputType>Library</OutputType>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="$(XunitProjectPath)" />
		<ProjectReference Include="$(FuxionProjectPath)" />
		<ProjectReference Include="$(HttpProjectPath)" />
		<ProjectReference Include="$(Test_Responses_Shared_FixturesProjectPath)" />
	</ItemGroup>

</Project>
