<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>$(CoreAndOldFrameworks)</TargetFrameworks>
		<!-- test/Directory.Build.props sets OutputType=Exe for everything under test/ (through
		     .config/props/Project.Test.props), and xunit.v3's own build validation requires it anyway for any project that
		     references xunit.v3, even a library like this one that hosts no [Fact] itself (Fuxion.Xunit does exactly the
		     same for the same reason). XunitAutoGeneratedEntryPoint is turned off so that Exe stays a formality: no
		     runner Main is generated (Program.cs holds an inert one), and this project is not a phantom test runner. -->
		<XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
		<IsPackable>false</IsPackable>
		<IsTestProject>false</IsTestProject>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="$(XunitProjectPath)" />
		<ProjectReference Include="$(FuxionProjectPath)" />
		<ProjectReference Include="$(HttpProjectPath)" />
		<ProjectReference Include="$(Test_Responses_Shared_FixturesProjectPath)" />
	</ItemGroup>

</Project>
