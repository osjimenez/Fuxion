<Project>

	<!-- The test projects say <IsTestProject>true</IsTestProject> in their .csproj; the space's test.targets does the
	     rest, and its fuxion-analyzers.targets the analyzers -->
	<Import Project="Sdk.props" Sdk="Fuxion.Tool.Sdk" />

	<PropertyGroup>
		<!-- Remove warnings to moderate and high vulnerabilities in nugets -->
		<NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
	</PropertyGroup>

</Project>
