<Project>
	
	<!--<Import Project="..\\..\\solution\\Directory.Build.props" Condition="Exists('..\\..\\solution\\Directory.Build.props')" />-->

	<PropertyGroup>
		<LangVersion>preview</LangVersion>
		<Nullable>enable</Nullable>
		<WarningsAsErrors>Nullable</WarningsAsErrors>
		<!-- Con esto me deja poner versiones prerelease en paquetes nuget con version estable -->
		<NoWarn>$(NoWarn);NU5104</NoWarn>
		<ImplicitUsings>disable</ImplicitUsings>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

		<!-- TARGET FRAMEWORKS -->
		<OldFrameworks>net472</OldFrameworks>
		<IsOldFrameworks Condition="'$(TargetFramework)' == 'net472'">true</IsOldFrameworks>
		<StandardFramework>netstandard2.0</StandardFramework>
		<IsStandardFramework Condition="'$(TargetFramework)' == 'netstandard2.0'">true</IsStandardFramework>
		<CoreFrameworks>net8.0;net9.0;net10.0</CoreFrameworks>
		<IsCoreFrameworks Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net9.0' Or '$(TargetFramework)' == 'net10.0'">true</IsCoreFrameworks>
		<CoreWindowsFrameworks>net8.0-windows;net9.0-windows;net10.0-windows</CoreWindowsFrameworks>
		<LatestCoreFramework>net10.0</LatestCoreFramework>
		<LatestCoreWindowsFramework>net10.0-windows</LatestCoreWindowsFramework>

		<!-- To bellow, only are variables, you don't need touch this -->

		<IsCoreOrOldFrameworks Condition="'$(IsCoreFrameworks)' == 'true' Or '$(IsOldFrameworks)' == 'true'">true</IsCoreOrOldFrameworks>
		<IsStandardOrOldFrameworks Condition="'$(IsStandardFramework)' == 'true' Or '$(IsOldFrameworks)' == 'true'">true</IsStandardOrOldFrameworks>

		<DefaultFrameworks>$(StandardFramework);$(OldFrameworks);$(CoreFrameworks)</DefaultFrameworks>
		<CoreAndOldFrameworks>$(OldFrameworks);$(CoreFrameworks)</CoreAndOldFrameworks>
		<WindowsFrameworks>$(OldFrameworks);$(CoreWindowsFrameworks)</WindowsFrameworks>
	</PropertyGroup>

	<PropertyGroup Condition="'$(IsOldFrameworks)' == 'true'">
		<DefineConstants>$(DefineConstants);OLD_FRAMEWORKS</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(IsStandardOrOldFrameworks)' == 'true'">
		<DefineConstants>$(DefineConstants);STANDARD_OR_OLD_FRAMEWORKS</DefineConstants>
	</PropertyGroup>

	<!-- ========================================== -->
	<!-- ANALYZER PATHS: Centralized configuration  -->
	<!-- Available to ALL projects (src/ and test/) -->
	<!-- ========================================== -->
	<PropertyGroup>
		<!-- Base directories (relative to solution root) -->
		<FuxionAnalyzersAbstractionsDir>$(MSBuildThisFileDirectory)src\Analyzers.Abstractions\</FuxionAnalyzersAbstractionsDir>
		<FuxionAnalyzersDir>$(MSBuildThisFileDirectory)src\Analyzers\</FuxionAnalyzersDir>
		<FuxionAnalyzersCodeFixesDir>$(MSBuildThisFileDirectory)src\Analyzers.CodeFixes\</FuxionAnalyzersCodeFixesDir>
		
		<!-- Project files -->
		<FuxionAnalyzersAbstractionsProject>$(FuxionAnalyzersAbstractionsDir)Fuxion.Analyzers.Abstractions.csproj</FuxionAnalyzersAbstractionsProject>
		<FuxionAnalyzersProject>$(FuxionAnalyzersDir)Fuxion.Analyzers.csproj</FuxionAnalyzersProject>
		<FuxionAnalyzersCodeFixesProject>$(FuxionAnalyzersCodeFixesDir)Fuxion.Analyzers.CodeFixes.csproj</FuxionAnalyzersCodeFixesProject>
		
		<!-- Output DLLs (relative to project bin folder) -->
		<FuxionAnalyzersAbstractionsDll>$(FuxionAnalyzersAbstractionsDir)bin\$(Configuration)\netstandard2.0\Fuxion.Analyzers.Abstractions.dll</FuxionAnalyzersAbstractionsDll>
		<FuxionAnalyzersDll>$(FuxionAnalyzersDir)bin\$(Configuration)\netstandard2.0\Fuxion.Analyzers.dll</FuxionAnalyzersDll>
		<FuxionAnalyzersCodeFixesDll>$(FuxionAnalyzersCodeFixesDir)bin\$(Configuration)\netstandard2.0\Fuxion.Analyzers.CodeFixes.dll</FuxionAnalyzersCodeFixesDll>
		
		<!-- NuGet package path for analyzers -->
		<AnalyzersPackagePath>analyzers/dotnet/cs</AnalyzersPackagePath>
	</PropertyGroup>

	<!-- ========================================== -->
	<!-- AUTO-REFERENCE ANALYZERS: All projects     -->
	<!-- Automatically adds analyzer references     -->
	<!-- to ALL projects except the analyzers       -->
	<!-- themselves and explicitly excluded ones    -->
	<!-- ========================================== -->
	<ItemGroup Condition="'$(MSBuildProjectName)' != 'Fuxion.Analyzers.Abstractions' And '$(MSBuildProjectName)' != 'Fuxion.Analyzers' And '$(MSBuildProjectName)' != 'Fuxion.Analyzers.CodeFixes' And '$(MSBuildProjectName)' != 'Fuxion.Lab.AppHost'">
		<!-- Abstractions Project Reference (for [RequiresNotNull] attribute) -->
		<ProjectReference Include="$(FuxionAnalyzersAbstractionsProject)" Condition="Exists('$(FuxionAnalyzersAbstractionsProject)')">
			<ReferenceOutputAssembly>true</ReferenceOutputAssembly>
			<PrivateAssets>none</PrivateAssets>
		</ProjectReference>
		
		<!-- Analyzer Project Reference (compile-time checks) -->
		<ProjectReference Include="$(FuxionAnalyzersProject)" Condition="Exists('$(FuxionAnalyzersProject)')">
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
			<OutputItemType>Analyzer</OutputItemType>
			<PrivateAssets>all</PrivateAssets>
		</ProjectReference>
		
		<!-- CodeFix Project Reference (quick fixes) -->
		<ProjectReference Include="$(FuxionAnalyzersCodeFixesProject)" Condition="Exists('$(FuxionAnalyzersCodeFixesProject)')">
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
			<OutputItemType>Analyzer</OutputItemType>
			<PrivateAssets>all</PrivateAssets>
		</ProjectReference>

		<!-- Force-load in VS (important) -->
		<Analyzer Include="$(FuxionAnalyzersDll)" Condition="Exists('$(FuxionAnalyzersDll)')" />
		<Analyzer Include="$(FuxionAnalyzersCodeFixesDll)" Condition="Exists('$(FuxionAnalyzersCodeFixesDll)')" />
	</ItemGroup>

	<ItemGroup Condition="'$(IsStandardOrOldFrameworks)' == 'true'">
		<PackageReference Include="PolySharp">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>