<Project>

	<!-- Files -->
	<Import Project="$(MSBuildThisFileDirectory)..\.config\Files.props" />
	<Import Project="$(MSBuildThisFileDirectory)..\..\..\solution\.config\Files.props"
	        Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\solution\.config\Files.props')"/>

	<!-- Fuxion.Tools.Sdk (design §7): the defaults, the packages and the XML documentation (what .config's
	     Project.Default, Nuget.Metadata and Documentation did). Versioning is off until oss has its version/ base tag
	     (plan L): inside Fuxion-plus, its frozen tool still versions these projects. -->
	<PropertyGroup>
		<FxPackable>true</FxPackable>
		<FxVersioningEnabled>false</FxVersioningEnabled>
		<FxDocumentationLanguages>es</FxDocumentationLanguages>
		<FxPackageIconFile>$(MSBuildThisFileDirectory)..\.config\icon.png</FxPackageIconFile>
		<Authors>Oscar Jimenez</Authors>
		<Product>Fuxion</Product>
		<ProductName>Fuxion</ProductName>
	</PropertyGroup>
	<Import Project="Sdk.props" Sdk="Fuxion.Tools.Sdk" />

	<!-- Core -->
	<Import Project="$(Core_Frameworks_Prop)" />
	<Import Project="$(Core_Paths_Prop)" />
	<Import Project="$(Core_Paths_Plus_Prop)" Condition="Exists('$(Core_Paths_Plus_Prop)')"/>
	<!-- Analyzers -->
	<Import Project="$(Analyzers_Reference_Prop)" />
	<!-- Nuget: license, repository and the analyzers inside the packages (oss's own) -->
	<Import Project="$(Nuget_Config_OpenSource_Prop)" />
	<Import Project="$(Nuget_Pack_Analyzers_Prop)" />
	<PropertyGroup>
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeAnalyzersAbstractionsInPackage</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>

</Project>
