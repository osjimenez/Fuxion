<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>$(DefaultFrameworks)</TargetFrameworks>
		<Title>Fuxion</Title>

		<PackageId>Fuxion</PackageId>
		<Description>Fuxion library with built-in Roslyn analyzers for compile-time safety checks</Description>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging.Configuration" />
		<PackageReference Include="System.Text.Json" />
	</ItemGroup>
	
	<ItemGroup Condition="'$(IsStandardOrOldFrameworks)' == 'true'">
		<PackageReference Include="Microsoft.CSharp" />
	</ItemGroup>

	<ItemGroup Condition="'$(IsOldFrameworks)' == 'true'">
		<Reference Include="System.Net.Http" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Resources\Strings.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Strings.resx</DependentUpon>
		</Compile>
		<EmbeddedResource Update="Resources\Strings.resx">
			<Generator>PublicResXFileCodeGenerator</Generator>
			<LastGenOutput>Strings.Designer.cs</LastGenOutput>
		</EmbeddedResource>

		<Compile Update="SemanticVersion.Exception.cs">
			<DependentUpon>SemanticVersion.cs</DependentUpon>
		</Compile>
		<Compile Update="SemanticVersion.Identifier.cs">
			<DependentUpon>SemanticVersion.cs</DependentUpon>
		</Compile>
		<Compile Update="SemanticVersion.IdentifierCollection.cs">
			<DependentUpon>SemanticVersion.cs</DependentUpon>
		</Compile>
		<Compile Update="ImmutableExtensions.cs">
			<DependentUpon>ExtensionsDictionary.cs</DependentUpon>
		</Compile>
		<Compile Update="Response.Accept.cs">
			<DependentUpon>Response.cs</DependentUpon>
		</Compile>
		<Compile Update="Response.EXT.cs">
			<DependentUpon>Response.cs</DependentUpon>
		</Compile>
		<Compile Update="Response.Exceptions.cs">
			<DependentUpon>Response.cs</DependentUpon>
		</Compile>
		<Compile Update="Response.IOContent.cs">
			<DependentUpon>Response.cs</DependentUpon>
		</Compile>
		<Compile Update="Response.IOContent.Sources.cs">
			<DependentUpon>Response.cs</DependentUpon>
		</Compile>
		<Compile Update="Response.INT.cs">
			<DependentUpon>Response.cs</DependentUpon>
		</Compile>
		<Compile Update="Response.Json.cs">
			<DependentUpon>Response.cs</DependentUpon>
		</Compile>
		<Compile Update="Response.MediaTypes.cs">
			<DependentUpon>Response.cs</DependentUpon>
		</Compile>
		<Compile Update="Response.Naming.cs">
			<DependentUpon>Response.cs</DependentUpon>
		</Compile>
		<Compile Update="Response.Options.cs">
			<DependentUpon>Response.cs</DependentUpon>
		</Compile>
		<Compile Update="Response.ProblemDetails.cs">
			<DependentUpon>Response.cs</DependentUpon>
		</Compile>
		<Compile Update="Response.ProblemDetails.EXT.cs">
			<DependentUpon>Response.cs</DependentUpon>
		</Compile>
		<Compile Update="Response.Wire.cs">
			<DependentUpon>Response.cs</DependentUpon>
		</Compile>
		<Compile Update="Error.EXT.cs">
			<DependentUpon>Error.cs</DependentUpon>
		</Compile>
		<Compile Update="Error.Json.cs">
			<DependentUpon>Error.cs</DependentUpon>
		</Compile>
	</ItemGroup>
</Project>
