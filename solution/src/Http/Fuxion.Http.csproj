<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>$(DefaultFrameworks)</TargetFrameworks>
		<Title>Fuxion Http</Title>
		<PackageId>Fuxion.Http</PackageId>
		<Description>Fuxion library for HTTP clients consuming Fuxion responses.</Description>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Http" />
	</ItemGroup>
	
	<ItemGroup Condition="'$(IsOldFrameworks)' == 'true'">
		<Reference Include="System.Net.Http" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="$(FuxionProjectPath)" />
	</ItemGroup>

</Project>
