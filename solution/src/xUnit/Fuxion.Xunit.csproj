<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>$(CoreAndOldFrameworks)</TargetFrameworks>
		<Title>Fuxion Xunit</Title>
		<PackageId>Fuxion.Xunit</PackageId>
		<Description>Fuxion Xunit</Description>
		<IsPackable>true</IsPackable>
	</PropertyGroup>

	<!-- A test support library, not a test project: xunit.v3.extensibility.core (instead of xunit.v3) keeps it a plain
	     library. Test projects get xunit.v3 themselves (.config/props/Project.Test.props). -->
	<ItemGroup>
		<PackageReference Include="xunit.analyzers" PrivateAssets="all" />
		<PackageReference Include="xunit.v3.assert" />
		<PackageReference Include="xunit.v3.extensibility.core" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="$(FuxionProjectPath)" />
	</ItemGroup>

</Project>
