<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>$(StandardFramework)</TargetFramework>

		<!-- Required for code fix providers -->
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		
		<!-- Disable Nuget -->
		<IsPackable>false</IsPackable>

		<!-- not the analyzers of Fuxion in themselves (the workspace's fuxion-analyzers.targets) -->
		<UseFuxionAnalyzers>false</UseFuxionAnalyzers>

	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<FxReference Include="Fuxion.Analyzers.Abstractions" PrivateAssets="none" />
	</ItemGroup>

</Project>
