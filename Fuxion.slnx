    <Project Path="solution/test/Fuxion/Test.Fuxion.csproj" />
    <Project Path="solution/test/Http/Test.Http.csproj" />
    <Project Path="solution/test/Responses.Shared.Fixtures/Test.Responses.Shared.Fixtures.csproj" />
